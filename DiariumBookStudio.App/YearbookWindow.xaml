<Window x:Class="DiariumBookStudio.YearbookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jahresbuch drucken" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Ein Buch pro Jahr: Einstellungen prüfen, dann erzeugt die App Innenteil, Umschlag und Bestellanleitung als Druckpaket."
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Jahr:" VerticalAlignment="Center" />
            <ComboBox x:Name="YearBox" Grid.Column="1" Width="100" HorizontalAlignment="Left" SelectionChanged="YearBox_SelectionChanged" />

            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="YearInfoText" Foreground="Gray" Margin="0,4,0,8" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Text="Titel:" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TitleBox" Padding="3" Margin="0,0,0,6"
                     SpellCheck.IsEnabled="True" Language="de-DE" />

            <TextBlock Grid.Row="3" Text="Untertitel:" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="SubtitleBox" Padding="3" Margin="0,0,0,6"
                     SpellCheck.IsEnabled="True" Language="de-DE" />

            <TextBlock Grid.Row="4" Text="Druckerei:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ProfileBox" />
        </Grid>

        <GroupBox Header="Automatik" Margin="0,12,0,0" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="AutoPhotosCheckBox" IsChecked="True" VerticalAlignment="Center"
                              Content="Fotos ungeprüfter Einträge automatisch auswählen, höchstens" />
                    <TextBox x:Name="MaxPhotosBox" Width="36" Margin="6,0" Padding="2,0" VerticalAlignment="Center" />
                    <TextBlock Text="je Eintrag" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Foreground="Gray" FontSize="11" Margin="20,2,0,8" TextWrapping="Wrap"
                           Text="Serienbilder (fast gleiche Fotos hintereinander) werden zu einem Foto zusammengefasst, der Rest gleichmäßig über den Tag verteilt. Titelbilder bleiben. Geprüfte Einträge bleiben unverändert." />
                <CheckBox x:Name="MarkDoneCheckBox" Content="Danach alle Einträge des Jahres als geprüft markieren" />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Druckpaket erzeugen" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="Start_Click" />
            <Button Content="Abbrechen" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
