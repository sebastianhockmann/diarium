<Window x:Class="DiariumBookStudio.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Vorschau" Width="1150" Height="900" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Eine Buchseite: Bild mit Schatten, darunter Seitenzahl und Einträge. Leere Seite (vor Seite 1) bleibt frei. -->
        <DataTemplate x:Key="PageTemplate">
            <StackPanel Width="{Binding PageWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="1,0">
                <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="Page_MouseLeftButtonDown" Tag="{Binding}"
                        ToolTip="Doppelklick: Eintrag zum Bearbeiten öffnen">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" />
                    </Border.Effect>
                    <Image Source="{Binding Image}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="2,4,2,0"
                           TextAlignment="{Binding CaptionAlignment}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="MonthScope" Content="Ganzer Monat" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <RadioButton x:Name="EntryScope" Content="Nur ausgewählter Eintrag" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="↻ Aktualisieren" Padding="10,3" Margin="0,0,8,0" Click="Refresh_Click"
                            ToolTip="Vorschau für den in der Hauptansicht ausgewählten Eintrag neu setzen" />
                    <Button x:Name="OpenPdfButton" Content="PDF öffnen" Padding="10,3" Click="OpenPdf_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Größe" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="ZoomSlider" Width="140" Minimum="200" Maximum="900" Value="440" VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Foreground="#444" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#E8E8E8">
                <ItemsControl x:Name="SpreadList" Margin="0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Doppelseite: links gerade, rechts ungerade Seite -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource PageTemplate}"
                                                Width="{Binding PageWidth, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" />
                                <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource PageTemplate}"
                                                Width="{Binding PageWidth, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="BusyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#666"
                       Text="Vorschau wird erzeugt..." Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
