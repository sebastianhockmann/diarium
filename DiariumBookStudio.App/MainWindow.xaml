<Window x:Class="DiariumBookStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DiariumBookStudio.Models"
        Title="Diarium Book Studio v22" Height="820" Width="1350" MinHeight="650" MinWidth="1100">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Diarium-ZIP importieren..." Click="ImportZip_Click" />
                <MenuItem Header="Entpackten Diarium-Ordner importieren..." Click="ImportFolder_Click" />
                <MenuItem Header="Projekt öffnen..." Click="OpenProject_Click" />
                <Separator />
                <MenuItem Header="Projekt speichern" Click="SaveProject_Click" />
                <MenuItem Header="LaTeX erzeugen unter..." Click="ExportLatex_Click" />
                <Separator />
                <MenuItem Header="Beenden" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0" Height="40">
            <ToolBar>
                <Button ToolTip="Diarium-ZIP importieren" Click="ImportZip_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" Margin="0,0,5,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
                <Button ToolTip="Entpackten Diarium-Ordner importieren" Click="ImportFolder_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗂️" Margin="0,0,5,0" />
                        <TextBlock Text="Ordner" />
                    </StackPanel>
                </Button>
                <Button ToolTip="Projekt öffnen" Click="OpenProject_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" Margin="0,0,5,0" />
                        <TextBlock Text="Öffnen" />
                    </StackPanel>
                </Button>
                <Button ToolTip="Projekt speichern" Click="SaveProject_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" Margin="0,0,5,0" />
                        <TextBlock Text="Speichern" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button ToolTip="LaTeX-Datei erzeugen" Click="ExportLatex_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" Margin="0,0,5,0" />
                        <TextBlock Text="LaTeX" />
                    </StackPanel>
                </Button>
                <Button ToolTip="PDF mit LuaLaTeX erzeugen und öffnen" Click="GeneratePdf_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📕" Margin="0,0,5,0" />
                        <TextBlock Text="PDF erzeugen &amp; öffnen" />
                    </StackPanel>
                </Button>
                <Button ToolTip="Ausgabeordner öffnen" Click="OpenOutputFolder_Click" Padding="8,4" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,5,0" />
                        <TextBlock Text="Ausgabeordner" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit. Importiere eine Diarium-ZIP-Datei." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <ProgressBar x:Name="BuildProgressBar" Width="180" Height="14" IsIndeterminate="True" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding AppVersion}" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Buchtitel:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="BookTitleBox" Width="240" Padding="3" TextChanged="BookSettings_Changed" />
                <TextBlock Text="Untertitel:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="BookSubtitleBox" Width="240" Padding="3" TextChanged="BookSettings_Changed" />
                <TextBlock Text="Jahr:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="YearComboBox" Width="90" SelectionChanged="YearComboBox_SelectionChanged"
                          ToolTip="Nur Einträge dieses Jahres anzeigen und ins Buch übernehmen" />
                <CheckBox x:Name="PrintVersionCheckBox" Content="Druckversion (3 mm Beschnitt, Seitenzahl durch 4 teilbar)" VerticalAlignment="Center" Margin="16,0,0,0"
                          Checked="BookSettings_Changed" Unchecked="BookSettings_Changed" />
                <CheckBox x:Name="GrayAccentsCheckBox" Content="Akzente in Graustufen" VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="Datum, Symbole, Linien und Karten in Grau. Seiten ohne Fotos zählen dann beim Druck als Schwarz-Weiß-Seiten (günstiger)."
                          Checked="BookSettings_Changed" Unchecked="BookSettings_Changed" />
            </WrapPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Einträge nach Monat" Grid.Column="0" Margin="0,0,10,0">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="6" Padding="5" TextChanged="SearchBox_TextChanged" ToolTip="Suche nach Datum, Titel oder Text" />
                    <TreeView x:Name="EntryTree" Margin="6" SelectedItemChanged="EntryTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:MonthGroup}" ItemsSource="{Binding Entries}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type models:EntryModel}">
                                <Border x:Name="EntryBorder" Padding="3" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock x:Name="EntryText" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="EntryState" Text="nicht geprüft" FontSize="11" Foreground="Gray" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="EntryBorder" Property="Background" Value="#E6F4EA" />
                                        <Setter TargetName="EntryText" Property="Foreground" Value="#146C2E" />
                                        <Setter TargetName="EntryText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="EntryState" Property="Text" Value="geprüft" />
                                        <Setter TargetName="EntryState" Property="Foreground" Value="#146C2E" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Textbearbeitung" Grid.Column="1" Margin="0,0,10,0">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="EntryTitle" FontSize="18" FontWeight="SemiBold" Text="Kein Eintrag ausgewählt" TextWrapping="Wrap" />
                        <TextBlock x:Name="EntryMeta" Foreground="Gray" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Ort im Buch:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="PlaceNameBox" Width="260" Padding="3" TextChanged="PlaceNameBox_TextChanged"
                                     ToolTip="Wird beim Export automatisch aus den Koordinaten ermittelt, falls leer." />
                        </StackPanel>
                        <TextBlock Text="Formatierung: **fett**, *kursiv*, Zeilen mit „- “ werden zur Liste." Foreground="Gray" FontSize="11" Margin="0,6,0,0" />
                        <CheckBox x:Name="DoneCheckBox" Content="Eintrag für das Buch geprüft" Margin="0,8,0,0" Checked="DoneCheckBox_Changed" Unchecked="DoneCheckBox_Changed" />
                    </StackPanel>
                    <TextBox x:Name="EditedTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" TextChanged="EditedTextBox_TextChanged" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Bilder auswählen und sortieren" Grid.Column="2">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Alle auswählen" Margin="0,0,6,0" Click="SelectAllImages_Click" />
                        <Button Content="Keine" Margin="0,0,6,0" Click="SelectNoImages_Click" />
                        <Button Content="Erste 6" Margin="0,0,6,0" Click="SelectFirstSix_Click" />
                        <TextBlock x:Name="ImageCountText" VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ImagesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding FullPath}" Width="120" Height="120" Stretch="UniformToFill" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <CheckBox Content="Ins Buch übernehmen" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                                <CheckBox Content="Titelbild (groß über dem Text)" IsChecked="{Binding IsHero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                                          Checked="HeroCheckBox_Checked" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="Reihenfolge:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Button Content="↑" Width="28" Margin="0,0,3,0" Click="MoveImageUp_Click" />
                                                    <Button Content="↓" Width="28" Click="MoveImageDown_Click" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="4" ToolTip="Bildunterschrift" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
