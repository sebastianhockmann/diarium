<Window x:Class="DiariumBookStudio.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorabprüfung" Height="520" Width="900" MinHeight="300" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Doppelklick oder „Zum Eintrag“ öffnet den betroffenen Eintrag zum Bearbeiten. Fehler: Foto fehlt im Buch. Warnung: Foto wird deutlich unscharf. Hinweis: kleinere Auffälligkeiten." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="GoToEntryButton" Content="Zum Eintrag" Padding="12,4" Margin="0,0,8,0" Click="GoToEntry_Click" />
            <Button x:Name="ContinueButton" Content="PDF trotzdem erzeugen" Padding="12,4" Margin="0,0,8,0" Click="Continue_Click" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Abbrechen" Padding="12,4" IsCancel="True" />
        </StackPanel>
        <ListView x:Name="IssueList" MouseDoubleClick="IssueList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Art" Width="80" DisplayMemberBinding="{Binding SeverityText}" />
                    <GridViewColumn Header="Eintrag" Width="260" DisplayMemberBinding="{Binding EntryText}" />
                    <GridViewColumn Header="Problem" Width="520">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
